# Copy to apps/api/.env (ignored by Git). Never put server secrets in VITE_* variables.
NODE_ENV=development
PORT=8900
DATA_DIR=.data/pg

# Default: codes print in the terminal running this API.
MAIL_MODE=console
# To send real codes locally, set MAIL_MODE=resend and fill these in privately:
RESEND_API_KEY=
MAIL_FROM=
# Example MAIL_FROM after domain verification: Gossamer <login@your-domain.example>
# Before verification, onboarding@resend.dev may send to your own Resend account email only.

# Set SIGN_IN_MODE=public to let anyone verify their email and sign in.
# SIGN_IN_MODE=invite requires the comma-separated list below.
# Without a mode, production defaults to invite; local development honors any allowlist.
SIGN_IN_MODE=
SIGN_IN_ALLOWLIST=

# Hosted production only (set through the hosting dashboard, not this committed file):
# NODE_ENV=production
# DATABASE_URL=provider-supplied-connection-string
# AUTH_SECRET=random-value-at-least-32-characters
# PUBLIC_ORIGIN=https://your-app.onrender.com
# On Render, omit PUBLIC_ORIGIN to use the platform's RENDER_EXTERNAL_URL.
# For a custom website domain, set PUBLIC_ORIGIN to its exact HTTPS origin.
# MAIL_MODE=resend
# RESEND_API_KEY=...
# MAIL_FROM=Gossamer <login@your-verified-domain.example>
# SIGN_IN_MODE=public
# For an invited pilot instead: SIGN_IN_MODE=invite and
# SIGN_IN_ALLOWLIST=your-email@example.com,friend@example.com
# WEB_DIST defaults to the sibling web/dist in production.
