{
  "name": "@spider-web/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "start": "node dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "@types/pg": "^8.23.1"
  }
}
