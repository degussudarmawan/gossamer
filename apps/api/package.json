{
  "name": "@spider-web/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "db:generate": "drizzle-kit generate",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate.js",
    "test:postgres": "vitest run src/db/postgres.integration.test.ts",
    "config:check": "node --env-file-if-exists=.env --import tsx src/check-config.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
